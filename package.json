{
  "name": "bangla-dict-web",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:load:dictionary": "node scripts/load-dictionary.mjs",
    "db:load:ipa": "node scripts/load-ipa.mjs",
    "db:load:complete": "node --max-old-space-size=4096 scripts/load-complete-dictionary.mjs",
    "db:load:pouranik": "node scripts/load-pouranik.mjs",
    "db:load:all": "npm run db:load:dictionary && npm run db:load:ipa && npm run db:load:complete && npm run db:load:pouranik",
    "db:stats": "node scripts/db-stats.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:deploy": "node scripts/verify-deploy-trace.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.35",
    "next-themes": "^0.4.4",
    "onnxruntime-web": "^1.20.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "csv-parse": "^5.6.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "pg-copy-streams": "^6.0.6",
    "postcss": "^8.4.49",
    "stream-json": "^1.9.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
