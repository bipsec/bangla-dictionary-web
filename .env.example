# Postgres connection string (Neon). Use the *pooled* connection string from the Neon
# dashboard; @neondatabase/serverless issues queries over HTTPS at request time, and the
# loader scripts in scripts/ connect to the same URL over TCP.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Canonical site origin, used by app/sitemap.ts and app/robots.ts.
NEXT_PUBLIC_SITE_URL=https://riddhidictionary.com
